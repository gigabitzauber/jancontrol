<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- We need to use LoggingSystem nevertheless. It's the Spring way of doing things. -->
    <Match>
        <Class name="de.gigabitzauber.jancontrol.JanControlApplication"/>
        <!-- This is a constructor match -->
        <Method name="&lt;init&gt;"
                params="de.gigabitzauber.jancontrol.cruise.CruiseConfigReader, de.gigabitzauber.jancontrol.cruise.CruiseCommand, org.springframework.boot.logging.LoggingSystem"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- False positive. -->
    <Match>
        <Class name="de.gigabitzauber.jancontrol.domain.Fan"/>
        <Method name="device" params=""/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!-- False positive. -->
    <Match>
        <Class name="de.gigabitzauber.jancontrol.domain.Fan"/>
        <!-- This is a constructor match -->
        <Method name="&lt;init&gt;"
                params="java.time.Duration, java.lang.Integer, java.lang.Integer, de.gigabitzauber.jancontrol.domain.RpmDevice, java.util.Collection, java.util.List"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Finalizer attack is very unlikely here -->
    <Match>
        <Class name="de.gigabitzauber.jancontrol.interpolation.PieceWiseInterpolator"/>
        <!-- This is a constructor match -->
        <Method name="&lt;init&gt;"
                params="de.gigabitzauber.jancontrol.domain.Curve"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- False positive. -->
    <Match>
        <Class name="de.gigabitzauber.jancontrol.JanControlApplication"/>
        <!-- This is a constructor match -->
        <Method name="&lt;init&gt;"
                params="com.fasterxml.jackson.dataformat.yaml.YAMLMapper, de.gigabitzauber.jancontrol.cruise.CruiseCommand, de.gigabitzauber.jancontrol.cruise.WatchConfigCommand, org.springframework.boot.logging.LoggingSystem"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
